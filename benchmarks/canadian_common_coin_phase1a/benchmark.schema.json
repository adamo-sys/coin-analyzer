{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "normalization_version",
    "classification",
    "sources",
    "policy",
    "freeze",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "ca-phase1a-benchmark-v1"
    },
    "policy_version": {
      "const": "ca-phase1a-policy-v1"
    },
    "normalization_version": {
      "const": "ca-phase1a-normalization-v1"
    },
    "classification": {
      "enum": [
        "SYNTHETIC",
        "REAL_HOLDOUT"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "metadata.schema.json#/$defs/source"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_split",
        "review",
        "thresholds"
      ],
      "properties": {
        "evaluation_split": {
          "const": "HOLDOUT"
        },
        "review": {
          "$ref": "metadata.schema.json#/$defs/review"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/threshold"
          }
        }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "metadata_sha256",
        "policy_sha256",
        "producer_ref"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "metadata.schema.json#/$defs/sha256"
        },
        "metadata_sha256": {
          "$ref": "metadata.schema.json#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "metadata.schema.json#/$defs/sha256"
        },
        "producer_ref": {
          "$ref": "metadata.schema.json#/$defs/text"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coin-analyzer:ca-phase1a-benchmark-v1",
  "title": "Offline benchmark; no ACCEPT, HUMAN VERIFY, save or mutation authority",
  "$defs": {
    "field": {
      "enum": [
        "country",
        "denomination",
        "year",
        "monarch",
        "reverse_design",
        "variety"
      ]
    },
    "state": {
      "enum": [
        "SUPPORTED",
        "AMBIGUOUS",
        "CONFLICTING",
        "ABSTAIN"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "side",
        "origin",
        "value"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "metadata.schema.json#/$defs/id"
        },
        "side": {
          "enum": [
            "OBVERSE",
            "REVERSE",
            "NONE"
          ]
        },
        "origin": {
          "enum": [
            "DIRECT",
            "CANDIDATE_METADATA"
          ]
        },
        "value": {
          "$ref": "metadata.schema.json#/$defs/text"
        }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "review",
        "source_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "review": {
          "$ref": "metadata.schema.json#/$defs/review"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "metadata.schema.json#/$defs/source_ref"
          }
        }
      }
    },
    "expected_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "expected_state",
        "truth",
        "required_evidence"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "expected_state": {
          "$ref": "#/$defs/state"
        },
        "truth": {
          "$ref": "#/$defs/truth"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "coin_group_id",
        "capture_group_id",
        "split",
        "input_ref",
        "input_sha256",
        "privacy",
        "issue_ids",
        "design_disposition",
        "fields"
      ],
      "properties": {
        "case_id": {
          "$ref": "metadata.schema.json#/$defs/id"
        },
        "coin_group_id": {
          "$ref": "metadata.schema.json#/$defs/id"
        },
        "capture_group_id": {
          "$ref": "metadata.schema.json#/$defs/id"
        },
        "split": {
          "enum": [
            "REFERENCE",
            "DEVELOPMENT",
            "HOLDOUT"
          ]
        },
        "input_ref": {
          "$ref": "metadata.schema.json#/$defs/text"
        },
        "input_sha256": {
          "$ref": "metadata.schema.json#/$defs/sha256"
        },
        "privacy": {
          "enum": [
            "SYNTHETIC",
            "SANITIZED_PUBLIC"
          ]
        },
        "issue_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "metadata.schema.json#/$defs/id"
          }
        },
        "design_disposition": {
          "$ref": "metadata.schema.json#/$defs/disposition"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/expected_field"
          }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "min_truth",
        "min_supported",
        "min_precision",
        "min_coverage"
      ],
      "properties": {
        "field": {
          "enum": [
            "country",
            "denomination",
            "year",
            "monarch",
            "reverse_design"
          ]
        },
        "min_truth": {
          "type": "integer",
          "minimum": 1
        },
        "min_supported": {
          "type": "integer",
          "minimum": 1
        },
        "min_precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recorded_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "state",
        "value",
        "candidate_ids",
        "evidence"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "candidate_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "metadata.schema.json#/$defs/id"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "recorded_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "execution",
        "fields"
      ],
      "properties": {
        "case_id": {
          "$ref": "metadata.schema.json#/$defs/id"
        },
        "execution": {
          "enum": [
            "SUCCESS",
            "MALFORMED_OUTPUT",
            "RUNTIME_FAILURE",
            "UNATTEMPTED"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/recorded_field"
          }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "producer_ref",
        "manifest_sha256",
        "cases"
      ],
      "properties": {
        "schema_version": {
          "const": "ca-phase1a-outcomes-v1"
        },
        "producer_ref": {
          "$ref": "metadata.schema.json#/$defs/text"
        },
        "manifest_sha256": {
          "$ref": "metadata.schema.json#/$defs/sha256"
        },
        "cases": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/recorded_case"
          }
        }
      }
    }
  }
}
